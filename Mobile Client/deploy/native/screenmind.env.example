SCREENMIND_PROVIDER=openai-compatible
SCREENMIND_MODEL_BASE_URL=https://maas.whu.edu.cn/v1
SCREENMIND_MODEL=deepseek-flash
SCREENMIND_MODEL_API_KEY=REPLACE_ON_SERVER
SCREENMIND_MEMORY_MODE=structured
SCREENMIND_MEMORY_EXTRACTOR=raw
SCREENMIND_MEMORY_PLANNING=false
SCREENMIND_EVIDENCE_REVIEW=true
SCREENMIND_CONCURRENCY=1
WEIGUANG_DB=/var/lib/screenmind/weiguang.sqlite3
WEIGUANG_AGENT_ROOT=/var/lib/screenmind/agents
WEIGUANG_RELEASE_DIR=/var/lib/screenmind-releases
