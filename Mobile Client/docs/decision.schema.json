{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weiguang Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "provider", "card_type", "title", "summary", "created_at", "expires_at", "status", "evidence_ids", "evidence", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "format": "uuid"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 80},
    "card_type": {"enum": ["summary", "question"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "created_at": {"type": "integer"},
    "expires_at": {"type": "integer"},
    "status": {"enum": ["active", "stale", "expired"]},
    "feedback": {"enum": [null, "accepted", "dismissed"]},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "revision"], "properties": {"event_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1}}}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["type", "label"], "properties": {"type": {"enum": ["accepted", "dismissed"]}, "label": {"type": "string", "minLength": 1, "maxLength": 20}}}}
  }
}
