  "components": {
    "schemas": {
      "ContextEvent": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision",
            "default": 1
          },
          "event_type": {
            "type": "string",
            "enum": [
              "message",
              "schedule",
              "location",
              "note"
            ],
            "title": "Event Type"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "screenshot_ocr",
              "manual",
              "calendar",
              "location"
            ],
            "title": "Source Kind"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Captured At"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "timezone": {
            "type": "string",
            "maxLength": 80,
            "title": "Timezone",
            "default": "Asia/Shanghai"
          },
          "review_status": {
            "type": "string",
            "const": "confirmed",
            "title": "Review Status",
            "default": "confirmed"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "source_kind",
          "captured_at",
          "payload"
        ],
        "title": "ContextEvent"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "DecisionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "event_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Event Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "event_ids"
        ],
        "title": "DecisionRequest"
      },
      "FeedbackInput": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accepted",
              "dismissed"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "FeedbackInput"
      },
      "GroupInput": {
        "properties": {
          "name": {
            "type": "string",
