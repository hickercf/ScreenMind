# Copy this file to .env. Process environment variables override .env values.
# Values are literal; no shell expansion, interpolation or inline comments.
SCREENMIND_PROVIDER=mock
# Real provider requires all three values; model name is deliberately not guessed.
# SCREENMIND_PROVIDER=openai-compatible
# SCREENMIND_MODEL_BASE_URL=https://api.deepseek.com/v1
# SCREENMIND_MODEL=your-tool-capable-model
# SCREENMIND_MODEL_API_KEY=your-secret
# Required when exposing the API beyond localhost. This is a single-user key.
# SCREENMIND_API_KEY=your-long-random-api-key
# SCREENMIND_ALLOWED_HOSTS=localhost,127.0.0.1,your-server-host
SCREENMIND_CONCURRENCY=2
SCREENMIND_MAX_STEPS=6
SCREENMIND_TASK_TIMEOUT=120
SCREENMIND_MODEL_TIMEOUT=40

# Optional enhanced memory. Install the optional dependencies first (docs/phase-two.md).
SCREENMIND_MEMORY_MODE=basic
SCREENMIND_MEMORY_EXTRACTOR=raw
# Small-server research path (SQLite lexical/entity retrieval; no semantic vectors):
# SCREENMIND_MEMORY_MODE=structured
# SCREENMIND_MEMORY_EXTRACTOR=structured
SCREENMIND_MEMORY_PLANNING=false
SCREENMIND_EVIDENCE_REVIEW=false
SCREENMIND_EMBEDDING=hash-demo
# SCREENMIND_MEMORY_MODE=hybrid
# SCREENMIND_MEMORY_EXTRACTOR=simplemem
# SCREENMIND_EMBEDDING=qwen
# SCREENMIND_EMBEDDING_MODEL_PATH=artifacts/models/Qwen3-Embedding-0.6B
SCREENMIND_INDEX_PATH=data/memory-index
SCREENMIND_ACTION_PATH=data/calendar-exports
# Fixed HTTPS calendar COLLECTION URL, not an account home page.
# SCREENMIND_CALDAV_URL=https://calendar.example/calendars/account/events/
# SCREENMIND_CALDAV_USERNAME=your-account
# SCREENMIND_CALDAV_PASSWORD=your-app-password

